---
import { hero } from '@/config.json'

interface Props {
  className?: string
}

const { className } = Astro.props
---

<ul
  class:list={[
    'social-list flex gap-4 flex-wrap items-center justify-center lg:justify-start',
    className,
  ]}
>
  {
    hero.socials.map((social, index) => (
      <li style={`--social-delay: ${index * 100}ms`}>
        <a
          class="relative size-9 text-white text-xl flex justify-center items-center group"
          href={social.url}
          title={social.name}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span
            class="absolute inset-0 -z-1 rounded-full group-hover:scale-105 transition"
            style={`background-color: ${social.color}`}
          />
          <i class:list={['iconfont', social.icon]} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* 用 CSS 动画代替 framer-motion：首屏无需等待 React 水合，图标随页面绘制立即出现 */
  .social-list > li {
    animation: social-item-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--social-delay, 0ms);
  }

  @keyframes social-item-in {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-list > li {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
