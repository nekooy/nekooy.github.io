---
import { getCollection } from 'astro:content'

interface ProjectItem {
  data: {
    title: string
    description: string
    image: string
    link: string
  }
}

const projects = (await getCollection('projects')) as unknown as ProjectItem[]
---

{
  projects.length > 0 && (
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-8">
      {projects.map((project) => (
        <li>
          <a
            class="block h-full"
            href={project.data.link}
            target="_blank"
            rel="noopener noreferrer external"
          >
            {/* 卡片在宽屏按行等高：外层撑满格子，图片区固定比例，文字区吃掉剩余高度 */}
            <div class="h-full flex flex-col overflow-hidden rounded-lg bg-accent/10 group">
              <div class="aspect-video shrink-0 overflow-hidden diagonal-stripes flex items-center justify-center">
                <img
                  class="size-1/2 object-contain transition-transform group-hover:scale-110"
                  src={project.data.image}
                  alt={`Project cover: ${project.data.title}`}
                  loading="lazy"
                />
              </div>
              <div class="p-4 grow">
                <div class="group-hover:text-accent">
                  <span class="text-xl font-bold">{project.data.title}</span>
                  <i class="ml-2 iconfont icon-external-link" />
                </div>
                <p class="mt-2 text-sm line-clamp-2">{project.data.description}</p>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  )
}
